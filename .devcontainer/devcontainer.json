{
  "name": "Libredeuda",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm run install:ci && node scripts/prepare-local.mjs",
  "postAttachCommand": "npm run dev",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Libredeuda",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/EJECUTAR.md"]
    }
  }
}
